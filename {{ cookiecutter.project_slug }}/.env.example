# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env && chmod 600 .env
#
# Read by BOTH languages from this one file:
#   R      : automatic, via readRenviron(".env") in .Rprofile
#   Python : from dotenv import load_dotenv; load_dotenv()
#
# Use KEY=value with no quotes and no `export` prefix — R's .Renviron parser
# does not strip quotes, so quoting would become part of the value.

# EXAMPLE_API_KEY=replace-me
